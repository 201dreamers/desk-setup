# ========================
# == Windows management ==
# ========================
# Zoom window
ctrl + cmd - z : yabai -m window --toggle zoom-fullscreen

# Make window floating
ctrl + cmd - space : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Make window sticky
ctrl + cmd - S : yabai -m window --toggle sticky

# Layout
ctrl + cmd - s: yabai -m space --layout stack
ctrl + cmd - b: yabai -m space --layout bsp

# Navigation
# ctrl + cmd - j : /bin/sh -c 'yabai -m window --focus stack.next || yabai -m window --focus stack.first'
# ctrl + cmd - k : /bin/sh -c 'yabai -m window --focus stack.prev || yabai -m window --focus stack.last'

# Jump to your absolute last workspace
ctrl + cmd - l : yabai -m space --focus last
# ctrl + cmd - l : yabai -m window --focus east

# Visual keyboard window switcher (current Space only), built with Hammerspoon.
# Opens the overlay; once open, release the modifier and use tab/shift-tab/
# arrows/j-k to move, "m" to toggle minimized windows, return to select,
# escape to cancel. Bound to both alt-tab and cmd-tab - the latter replaces
# macOS's native app switcher entirely (skhd consumes the keypress).
alt - tab : hs -c 'windowSwitcher.show()'
cmd - tab : hs -c 'windowSwitcher.show()'


# =====================
# == System controls ==
# =====================
# Increase keyboard brightness (ctrl + cmd + +)
ctrl + cmd - 0x18 : mac-brightnessctl $(echo "$(mac-brightnessctl | awk '{print $3}') + 0.1" | bc)
# Decrease keyboard brightness (ctrl + cmd + -)
ctrl + cmd - 0x1B : mac-brightnessctl $(echo "$(mac-brightnessctl | awk '{print $3}') - 0.1" | bc)

# ====================
# == Apps launchers ==
# ====================
# Terminal
# ctrl + cmd - return : osascript -e 'tell application "Terminal" to do script ""' -e 'tell application "Terminal" to activate'
ctrl + cmd - return : osascript -e 'tell application "Ghostty" to make new window' -e 'activate application "Ghostty"'

# Finder
ctrl + cmd - e : osascript -e 'tell application "Finder" to make new Finder window to home' -e 'tell application "Finder" to activate'

