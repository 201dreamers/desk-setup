// Place your key bindings in this file to override the defaults
[
    // ABM:
    {
        "key": "space r",
        "command": "workbench.action.showCommands",
        "when": "!(editorFocus || editorIsOpen)"
    },
    {
        "key": "space f",
        "command": "workbench.action.quickOpen",
        "when": "!(editorFocus || editorIsOpen)"
    },
    {
        "key": "space /",
        "command": "multiCommand.quickOpenPercent",
        "when": "!(editorFocus || editorIsOpen)"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "editorTextFocus"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !(inputFocus || editorFocus)"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !(inputFocus || editorFocus)"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "explorerViewletFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !(inputFocus || editorFocus)"
    },
    // Split navigation: move between editor groups, sidebar (file tree) and panel.
    // Skipped in vim insert mode, terminal, text inputs, quick open and suggestions.
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft",
        "when": "!terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight",
        "when": "!terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown",
        "when": "!terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.navigateUp",
        "when": "!terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
]
