// Place your key bindings in this file to override the defaults
[
    // ABM:
    {
        "key": "space r",
        "command": "workbench.action.showCommands",
        "when": "!(editorFocus || editorIsOpen)"
    },
    {
        "key": "space f",
        "command": "workbench.action.quickOpen",
        "when": "!(editorFocus || editorIsOpen)"
    },
    {
        "key": "space /",
        "command": "multiCommand.quickOpenPercent",
        "when": "!(editorFocus || editorIsOpen)"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "editorTextFocus"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !(inputFocus || editorFocus)"
    },
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !(inputFocus || editorFocus)"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "explorerViewletFocus"
    },
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !(inputFocus || editorFocus)"
    },
    // Split navigation: move between editor groups, sidebar (file tree) and panel.
    // Skipped in vim insert mode, terminal, text inputs, quick open and suggestions.
    // Explicit focus commands instead of workbench.action.navigate*: in Cursor those throw
    // "Unknown part workbench.parts.activitybar" when crossing into the sidebar or panel.
    // Sidebar sits on the right (workbench.sideBar.location). In Cursor the file tree doesn't set
    // sideBarFocus, so explorerViewletFocus / focusFilesExplorer are used too. Cursor also counts its
    // chat editor part in activeEditorGroupLast (never true there), so a single split checks the
    // per-part editorPartMultipleEditorGroups instead.
    {
        "key": "ctrl+h",
        "command": "workbench.action.focusLeftGroup",
        "when": "!sideBarFocus && !explorerViewletFocus && !panelFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "(sideBarFocus || explorerViewletFocus) && !inputFocus"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusRightGroup",
        "when": "editorPartMultipleEditorGroups && !activeEditorGroupLast && !explorerViewletFocus && !sideBarFocus && !panelFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.files.action.focusFilesExplorer",
        "when": "(activeEditorGroupLast || !editorPartMultipleEditorGroups) && !sideBarFocus && !explorerViewletFocus && !panelFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "!sideBarFocus && !explorerViewletFocus && !panelFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "!sideBarFocus && !explorerViewletFocus && !panelFocus && !terminalFocus && !inQuickOpen && !suggestWidgetVisible && !(inputFocus && !editorTextFocus) && !(editorTextFocus && vim.mode == 'Insert')"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "panelFocus && !terminalFocus && !inputFocus"
    },
    // Source control: ctrl+j from the commit message goes to the changed files, ctrl+k goes back.
    {
        "key": "ctrl+j",
        "command": "workbench.scm.action.focusNextResourceGroup",
        "when": "focusedView == 'workbench.scm'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.scm.action.focusPreviousInput",
        "when": "focusedView == 'workbench.scm'"
    },
]
